{
  "id": "drop-without-target",
  "description": "a drop with no active target fails closed",
  "inputs": [
    {
      "kind": "start",
      "envelope": {
        "protocol": "ores.dnd/v1",
        "dragId": "drag-0001",
        "sourceRuntime": "typescript-webview",
        "allowedOperations": [
          "copy",
          "move"
        ],
        "items": [
          {
            "kind": "text",
            "mediaType": "text/plain",
            "data": "hello"
          }
        ]
      }
    },
    {
      "kind": "drop",
      "targetId": "zone-a"
    }
  ],
  "expected": [
    {
      "state": "dragging",
      "dragId": "drag-0001"
    },
    {
      "state": "cancelled",
      "dragId": "drag-0001",
      "targetId": "zone-a",
      "errorCode": "no-active-target"
    }
  ]
}
