        "allowedOperations": [
          "copy",
          "move"
        ],
        "items": [
          {
            "kind": "text",
            "mediaType": "text/plain",
            "data": "hello"
          }
        ]
      }
    },
    {
      "kind": "enter",
      "targetId": "zone-form",
      "policy": {
        "targetId": "zone-form",
        "allowedOperations": [
          "copy"
        ],
        "acceptedKinds": [
          "text"
        ],
        "formId": "form-x"
      }
    }
  ],
  "expected": [
