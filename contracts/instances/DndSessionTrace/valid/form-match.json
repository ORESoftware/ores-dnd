          "copy",
          "move"
        ],
        "items": [
          {
            "kind": "text",
            "mediaType": "text/plain",
            "data": "hello"
          }
        ],
        "formId": "form-x"
      }
    },
    {
      "kind": "enter",
      "targetId": "zone-form",
      "policy": {
        "targetId": "zone-form",
        "allowedOperations": [
          "copy"
        ],
        "acceptedKinds": [
          "text"
        ],
        "formId": "form-x"
      }
    },
    {
      "kind": "drop",
