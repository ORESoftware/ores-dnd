{
  "id": "form-mismatch",
  "description": "a policy formId must match an envelope formId when both are present",
  "inputs": [
    {
      "kind": "start",
      "envelope": {
        "protocol": "ores.dnd/v1",
        "dragId": "drag-0001",
        "sourceRuntime": "typescript-webview",
        "allowedOperations": [
          "copy",
          "move"
        ],
        "items": [
          {
            "kind": "text",
            "mediaType": "text/plain",
            "data": "hello"
          }
        ],
        "formId": "form-y"
      }
    },
    {
      "kind": "enter",
      "targetId": "zone-form",
      "policy": {
        "targetId": "zone-form",
        "allowedOperations": [
          "copy"
        ],
        "acceptedKinds": [
          "text"
        ],
        "formId": "form-x"
      }
    }
  ],
  "expected": [
    {
      "state": "dragging",
      "dragId": "drag-0001"
    },
    {
      "state": "dragging",
      "dragId": "drag-0001",
      "targetId": "zone-form",
      "errorCode": "form-mismatch"
    }
  ]
}
