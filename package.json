{
  "name": "@oresoftware/ores-dnd-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Contract verification toolchain for ores-dnd",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "contracts:check": "tjsv check",
    "contracts:inventory": "tjsv inventory",
    "test": "npm run contracts:check && npm --prefix src/ts test && npm run conformance -- --skip dart",
    "conformance": "node scripts/conformance/run.mjs",
    "conformance:corpus": "node scripts/conformance/corpus.mjs",
    "conformance:verify": "node scripts/conformance/verify.mjs"
  },
  "devDependencies": {
    "@oresoftware/typespec-json-schema-validator": "https://github.com/ORESoftware/typespec-json-schema-validator/archive/246440fc876938376b036f8b7759e8dd2bed5794.tar.gz"
  }
}
